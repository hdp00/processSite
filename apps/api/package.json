{
  "name": "@process-site/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "pnpm build && pnpm db:migrate:compiled",
    "db:seed": "pnpm build && pnpm db:seed:compiled",
    "db:bootstrap": "pnpm build && pnpm db:migrate:compiled && pnpm db:seed:compiled",
    "db:migrate:compiled": "node dist/database/cli/migrate.js",
    "db:seed:compiled": "node dist/database/cli/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/typeorm": "11.0.3",
    "@process-site/api-contract": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ldapts": "9.0.0",
    "mssql": "12.7.0",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
