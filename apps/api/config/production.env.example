# 只填写部署环境必须提供的地址、账号和秘密。
# 其余端口、超时、连接池和安全默认值来自随代码发布的 defaults.env。
MSSQL_SERVER=<TCP可达的SQL Server主机>
MSSQL_PORT=1433
MSSQL_DATABASE=<数据库名>
MSSQL_USER=<应用运行账号>
MSSQL_PASSWORD='<应用运行密码>'
DOMAIN_AUTH_URLS=<LDAP或LDAPS地址>
DOMAIN_AUTH_BASE_DN=<目录搜索根>
DOMAIN_AUTH_UPN_SUFFIX=<UPN后缀>
SMTP_HOST=<SMTP主机或IP地址>
SMTP_USER=<可选SMTP认证账号>
SMTP_PASSWORD='<可选SMTP认证密码>'
SMTP_FROM=<固定发件邮箱>
FLOWPILOT_BOOTSTRAP_ADMIN_PASSWORD='<仅首次初始化使用>'

# 可选部署值，仅在需要时取消注释：
# DOMAIN_AUTH_NETBIOS_NAME=<NetBIOS域名>
# SMTP_TLS_SERVERNAME=<使用IP连接且启用TLS时的证书主机名>
# SMTP_REPLY_TO=<回复邮箱>
