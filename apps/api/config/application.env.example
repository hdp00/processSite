# 只填写部署环境必须确认的非敏感值。
# 其余稳定参数来自随代码发布的 apps/api/config/defaults.env。
# 分号分隔多个地址；邮件跟随触发请求命中的入口，无浏览器请求的系统任务才使用第一项。
FLOWPILOT_PUBLIC_BASE_URLS=http://<内网IIS主机名或IP>/flowpilot;http://<外网IIS主机名或IP>/flowpilot
MSSQL_EXPECTED_COLLATION=Chinese_PRC_CI_AS

# 只有对应环境确实需要时才取消注释并覆盖安全默认值：
# FLOWPILOT_COOKIE_SECURE=true
# DOMAIN_AUTH_ENABLED=false
# SMTP_ENABLED=false
# DOMAIN_AUTH_ALLOW_PLAINTEXT=true
# SMTP_REQUIRE_TLS=false
# SMTP_IGNORE_TLS=true
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERTIFICATE=true
