{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:3000"
      }
    }
  },
  "FlowPilot": {
    "Http": {
      "AllowedHosts": "localhost;127.0.0.1;[::1]"
    },
    "Authentication": {
      "CookieSecure": false
    },
    "Database": {
      "MinimumCompatibilityLevel": 130,
      "RequiredSchemaVersion": "202608280003",
      "RequiredBuiltinSeedVersion": "202608270001",
      "ApplicationCommandTimeoutSeconds": 30,
      "ReadinessCommandTimeoutSeconds": 5,
      "SchemaProbeCommandTimeoutSeconds": 15,
      "MigrationPreflightCommandTimeoutSeconds": 15,
      "MigrationCommandTimeoutSeconds": 300
    },
    "Attachments": {
      "MaximumFileSizeMb": 100,
      "MinimumFreeSpaceBytes": 2147483648
    },
    "Smtp": {
      "Enabled": false,
      "Security": "starttls",
      "MaxAttempts": 6,
      "BatchSize": 10,
      "TimeoutSeconds": 30
    },
    "BackgroundJobs": {
      "IntervalSeconds": 15,
      "StagedAttachmentLifetimeHours": 24,
      "SentEmailRetentionDays": 180
    },
    "Logging": {
      "FileSizeLimitBytes": 52428800,
      "RetainedFileCountLimit": 30
    }
  }
}
