{
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:3000"
      }
    }
  },
  "FlowPilot": {
    "Http": {
      "AllowedHosts": "localhost;127.0.0.1;[::1]"
    },
    "Authentication": {
      "CookieSecure": false
    },
    "Database": {
      "MinimumCompatibilityLevel": 130,
      "RequiredSchemaVersion": "202608260001",
      "RequiredBuiltinSeedVersion": "202608260001",
      "ApplicationCommandTimeoutSeconds": 30,
      "ReadinessCommandTimeoutSeconds": 5,
      "SchemaProbeCommandTimeoutSeconds": 15,
      "MigrationPreflightCommandTimeoutSeconds": 15,
      "MigrationCommandTimeoutSeconds": 300
    },
    "Logging": {
      "FileSizeLimitBytes": 52428800,
      "RetainedFileCountLimit": 30
    }
  }
}
