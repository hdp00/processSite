{
  "name": "@process-site/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.x",
    "pnpm": "11.1.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/generated/client/flowpilot.d.ts",
      "import": "./dist/generated/client/flowpilot.js",
      "default": "./dist/generated/client/flowpilot.js"
    },
    "./models": {
      "types": "./dist/generated/client/flowpilot.d.ts",
      "import": "./dist/generated/client/flowpilot.js",
      "default": "./dist/generated/client/flowpilot.js"
    },
    "./validators": {
      "types": "./dist/generated/validators/flowpilot.zod.d.ts",
      "import": "./dist/generated/validators/flowpilot.zod.js",
      "default": "./dist/generated/validators/flowpilot.zod.js"
    }
  },
  "scripts": {
    "lint:openapi": "redocly lint ../../document/flowpilot-rest-api.openapi.yaml --config redocly.yaml",
    "generate": "orval --config orval.config.ts",
    "generate:check": "node scripts/check-generated.mjs",
    "build": "pnpm generate && tsc -p tsconfig.json --pretty false",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "check": "pnpm lint:openapi && pnpm generate:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "axios": "1.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "2.47.0",
    "orval": "8.26.0",
    "typescript": "6.0.3"
  }
}
